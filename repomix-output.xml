<file path="apps/web/src/app/globals.css">
@import "tailwindcss";

:root {
  --paper: #f3f0e8;
  --paper-strong: #fffdf7;
  --ink: #17312f;
  --ink-soft: #62716d;
  --teal: #0b615c;
  --teal-deep: #074a47;
  --teal-pale: #dcebe6;
  --line: rgba(23, 49, 47, 0.13);
  --urgent: #b83a32;
  --urgent-pale: #f9e2dd;
  --gold: #b58b45;
  --shadow: 0 24px 70px rgba(24, 50, 47, 0.12);
}

* {
  box-sizing: border-box;
}

html,
body {
  height: 100%;
}

body {
  margin: 0;
  overflow: hidden;
  color: var(--ink);
  background:
    radial-gradient(circle at 18% 5%, rgba(255, 255, 255, 0.95), transparent 28rem),
    radial-gradient(circle at 92% 84%, rgba(168, 205, 194, 0.25), transparent 34rem),
    var(--paper);
  font-family: "Noto Sans SC", "Source Han Sans CN", "Microsoft YaHei", sans-serif;
}

button,
textarea {
  font: inherit;
}

button {
  color: inherit;
}

.app-shell {
  height: 100svh;
  display: grid;
  grid-template-columns: 244px minmax(0, 1fr) 286px;
  gap: 14px;
  padding: 16px;
}

.panel {
  border: 1px solid var(--line);
  border-radius: 24px;
  background: rgba(255, 253, 247, 0.96);
  box-shadow: var(--shadow);
}

.left-rail,
.right-rail {
  min-height: calc(100svh - 32px);
  padding: 22px 18px;
  overflow: hidden;
}

.left-rail {
  display: flex;
  flex-direction: column;
  background:
    linear-gradient(155deg, rgba(11, 97, 92, 0.98), rgba(7, 74, 71, 0.98)),
    var(--teal);
  color: #f7f4e9;
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 15px 15px 15px 4px;
  background: #f6f0df;
  color: var(--teal-deep);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.5);
}

.brand strong,
.chat-title,
.welcome h1,
.context-card h2 {
  font-family: "Noto Serif SC", "Source Han Serif CN", "Songti SC", serif;
}

.brand strong {
  display: block;
  font-size: 20px;
  letter-spacing: 0.02em;
}

.brand small {
  color: rgba(247, 244, 233, 0.66);
}

.new-visit {
  width: 100%;
  margin: 30px 0 24px;
  padding: 12px 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.1);
  cursor: pointer;
  transition: transform 160ms ease, background 160ms ease;
}

.new-visit:hover {
  transform: translateY(-1px);
  background: rgba(255, 255, 255, 0.16);
}

.new-visit:disabled,
.visit-item:disabled {
  cursor: wait;
  opacity: 0.58;
  transform: none;
}

.rail-label {
  margin: 0 0 10px;
  color: rgba(247, 244, 233, 0.52);
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.visit-list {
  min-height: 0;
  display: grid;
  align-content: start;
  gap: 8px;
  overflow-y: auto;
  padding-right: 3px;
}

.visit-item {
  width: 100%;
  padding: 12px;
  text-align: left;
  border: 0;
  border-radius: 14px;
  background: transparent;
  color: rgba(247, 244, 233, 0.7);
  cursor: pointer;
}

.visit-item.active {
  color: #fffdf7;
  background: rgba(255, 255, 255, 0.12);
}

.visit-item span,
.visit-item small {
  display: block;
}

.visit-item small {
  margin-top: 4px;
  color: inherit;
  opacity: 0.58;
}

.rail-error {
  margin: 12px 0 0;
  padding: 10px 12px;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 12px;
  background: rgba(106, 20, 18, 0.22);
  color: #fff4ed;
  font-size: 12px;
  line-height: 1.5;
}

.rail-footer {
  margin-top: auto;
  padding-top: 18px;
  border-top: 1px solid rgba(255, 255, 255, 0.13);
  color: rgba(247, 244, 233, 0.6);
  font-size: 12px;
  line-height: 1.7;
}

.chat-panel {
  min-width: 0;
  min-height: calc(100svh - 32px);
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto;
  overflow: hidden;
}

.chat-header {
  padding: 18px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--line);
}

.chat-title {
  margin: 0;
  font-size: 18px;
}

.chat-subtitle {
  margin: 4px 0 0;
  color: var(--ink-soft);
  font-size: 12px;
}

.mobile-visit-controls {
  display: none;
}

.online-badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 7px 10px;
  border-radius: 999px;
  background: var(--teal-pale);
  color: var(--teal-deep);
  font-size: 12px;
}

.online-badge::before {
  content: "";
  width: 7px;
  height: 7px;
