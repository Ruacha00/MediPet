      operation: "transition-skill",
      skillId: "skill-1",
      version: 2,
      action: "publish",
    });
    expect(router.refresh).toHaveBeenCalled();
    expect(screen.queryByRole("button", { name: "解绑 Tool" })).not.toBeInTheDocument();
  });
});
