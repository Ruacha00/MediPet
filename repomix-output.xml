def _object_schema(
    properties: dict[str, object], required: list[str]
) -> dict[str, object]:
    return {
        "type": "object",
        "properties": properties,
        "required": required,
        "additionalProperties": False,
    }


HOSPITAL_SCHEMA = _object_schema(
    {
        "hospital_id": {"type": "string"},
        "name": {"type": "string"},
