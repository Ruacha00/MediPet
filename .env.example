# Copy to .env and set your local DeepSeek key.
# SDK variable names describe the protocol; requests go to DeepSeek.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-flash
# Optional: keep empty for provider defaults; disabled fits the existing short JSON budgets.
MEDIPET_THINKING=disabled

# Host development connections. Compose overrides these with service names.
REDIS_URL=redis://:medipet-demo@127.0.0.1:6379/0
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma
EVAL_BASELINE_PATH=./data/eval/baseline.json
MEDIPET_SKILLS_DIR=./skills
MEDIPET_SKILLS_MAX_PROMPT_CHARS=5000
MEDIPET_COMPOSER_MAX_TOKENS=1000
MEDIPET_COMPOSER_TEMPERATURE=0.1
MEDIPET_TOOL_TRACE_MAX_ITEMS=200

# Intent embeddings are local and independent from chat/RAG models.
# First prepare assets with scripts/prepare_intent_embedding.py; runtime never downloads.
# This directory is for host Python; Compose uses the bundled /opt/medipet path.
MEDIPET_INTENT_EMBEDDING_BACKEND=semantic
MEDIPET_INTENT_EMBEDDING_MODEL_DIR=./data/models/intent/bge-small-zh-v1.5
MEDIPET_INTENT_EMBEDDING_FALLBACK=hash
MEDIPET_INTENT_EMBEDDING_TIMEOUT_MS=2000
MEDIPET_INTENT_EMBEDDING_THREADS=2

# Local demo ports and password.
MEDIPET_REDIS_PASSWORD=medipet-demo
MEDIPET_REDIS_PORT=6379
MEDIPET_CHROMA_PORT=8001
MEDIPET_API_PORT=8000
MEDIPET_WEB_PORT=8088
MEDIPET_PYTHON_API_URL=http://localhost:8000
LOG_LEVEL=INFO
MONITOR_INTERVAL=10
PROMETHEUS_PORT=0
ALERT_WEBHOOK_URL=
