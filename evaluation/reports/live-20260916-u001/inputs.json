        "patient_id": "patient_child",
        "turns": [
          "列出儿科今天尚可选择的号源。",
          "明天呢？"
        ],
        "preconditions": [
          "独立事项，预置患者与七天号源已初始化"
        ],
        "assertions": [
          "query.department_id=dep_pediatrics",
          "query.date=2026-09-17"
        ]
      },
      {
        "id": "period-followup",
        "title": "修改时段",
        "patient_id": "patient_child",
        "turns": [
          "查明天儿科上午能约的号。",
          "还是下午吧。"
        ],
        "preconditions": [
          "独立事项，预置患者与七天号源已初始化"
        ],
        "assertions": [
          "query.date=2026-09-17",
          "query.period=afternoon"
        ]
      },
      {
        "id": "list-selection",
        "title": "按实际序号选号",
        "patient_id": "patient_child",
        "turns": [
          "看一下明天儿科可选号源。",
          "我选第一项，请展示确认资料。"
        ],
        "preconditions": [
          "独立事项，预置患者与七天号源已初始化"
        ],
        "assertions": [
          "proposal.target_id=last_slot_list.slots[0].slot_id",
          "appointments.count=0"
        ]
      },
      {
        "id": "create-confirm",
        "title": "创建预约闭环",
        "patient_id": "patient_child",
        "turns": [
          "查明天儿科的号源。",
          "把第一项做成待确认方案。"
        ],
        "preconditions": [
          "独立事项，预置患者与七天号源已初始化"
        ],
        "assertions": [
          "before_confirmation.appointments.count=0",
          "after_confirmation.appointments.count=1",
          "after_confirmation.slot_delta=-1"
        ],
        "after_turns": [
          {
            "action": "confirm_current"
          }
        ]
      },
      {
        "id": "cancel-confirm",
        "title": "取消预约闭环",
        "patient_id": "patient_child",
        "turns": [
          "列出我当前的有效预约。",
          "准备取消列表中的第一条预约。"
        ],
